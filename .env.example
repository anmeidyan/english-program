APP_NAME=EnglishPath
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Show demo accounts + one-click login on /login (personal install)
SHOW_DEMO_LOGINS=true

APP_URL=http://localhost:8080
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Host ports (change if already used on your machine)
APP_PORT=8080
FORWARD_DB_PORT=3307
VITE_PORT=5173
FORWARD_MAILPIT_PORT=8025

# Docker host user (so bind-mounted files stay owned by you)
UID=1000
GID=1000

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=englishpath
DB_USERNAME=englishpath
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=englishpath

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@englishpath.test"
MAIL_FROM_NAME="${APP_NAME}"

# S3 / MinIO (prod). Start local MinIO with: docker compose --profile minio up -d
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=englishpath
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Web Push (generate with: php artisan webpush:vapid)
VAPID_SUBJECT="mailto:admin@englishpath.test"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Speech-to-text: browser | whisper
SPEECH_DRIVER=browser
WHISPER_API_KEY=

# AI grader: null | openai | anthropic
AI_GRADER_DRIVER=null
AI_GRADER_API_KEY=
AI_GRADER_MODEL=

# Daily speaking coach: auto (Claude when AI_GRADER_DRIVER=anthropic, else offline rules) | rules
SPEAKING_COACH=auto

VITE_APP_NAME="${APP_NAME}"
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"
